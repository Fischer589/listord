NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_ADMIN_WHATSAPP_PHONE=18090000000
NEXT_PUBLIC_APP_URL=http://localhost:3000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEEKLY_PRICE_ID=
STRIPE_MONTHLY_PRICE_ID=

# Nunca pongas SUPABASE_SERVICE_ROLE_KEY en variables NEXT_PUBLIC_*.
# La service role key solo debe vivir en entornos privados de servidor.
SUPABASE_SERVICE_ROLE_KEY=
WORKER_PHOTOS_BUCKET=worker-photos

# Admin panel authentication (Phase 0)
# ADMIN_USERNAME: choose a username for /admin access
# ADMIN_PASSWORD: use a strong random password (min 20 chars recommended)
# ADMIN_SESSION_SECRET: random 32+ char bearer secret stored in an HttpOnly cookie
# Admin reads/actions fail closed without a valid cookie. No auth bypass flag.
#   Generate with: openssl rand -hex 32
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Historical worker payment configuration only. No new products or sales.
# Preserve existing values for reviewed legacy reconciliation:
STRIPE_WORKER_FEATURED_PRICE_ID=
STRIPE_WORKER_PRO_PRICE_ID=

# Enable ONLY after availability migration + live privacy/authorization acceptance.
# Default keeps the Phase 2B conservative 30-day rule and disables renewal.
WORKER_AVAILABILITY_RENEWAL_ENABLED=false

# Containment gates: keep false pending approved legacy-token recovery and
# entitlement/payment acceptance. Never change postgres/auditor credentials.
LEGACY_WORKER_EDIT_ENABLED=false
LEGACY_CHECKOUT_ENABLED=false
# Separate RD$3,000 operator-led service; requires approved fulfillment before sales.
EMPLOYER_DEPOSIT_ENABLED=false
# One-time RD$299 / 30-day private employer workspace. Enable only after
# additive workspace migration and signed test-mode payment acceptance.
EMPLOYER_WORKSPACE_ENABLED=false
# Separate explicit owner approval is required before any live Stripe charge.
WORKSPACE_LIVE_PAYMENTS_ENABLED=false

# Only after staged auth, ownership, moderation and privacy acceptance.
MARKETPLACE_ENABLED=false
# Apply marketplace_featured migration before enabling this read path.
FEATURED_OPPORTUNITIES_ENABLED=false
# Separate purchase switch; only owner-approved active opportunities qualify.
FEATURED_CHECKOUT_ENABLED=false
# Leave false until the owner explicitly authorizes live RD$149 charges.
FEATURED_LIVE_PAYMENTS_ENABLED=false
# Express additionally requires approved provider, terms and settlement acceptance.
EXPRESS_ENABLED=false
# Leave acceptance attestations blank until external sandbox/owner acceptance.
EXPRESS_ACCEPTED_TERMS=
EXPRESS_SETTLEMENT_VERIFIED=
EXPRESS_OUTREACH_ACCEPTED=false
APP_ORIGIN=
EXPRESS_TRANSFER_CONTACT=
WHATSAPP_GRAPH_VERSION=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_EXPRESS_TEMPLATE=
WHATSAPP_ACCESS_TOKEN=
